+// Keep llvm.amdgcn.sched.{bank,vgpr,sgpr,agpr} hints alive across coalescing.
+// The coalescer merges \p Reg into \p NewReg and drops \p Reg. Without this the
+// surviving register keeps only its own (copy) hint, so a hint on a value that
+// becomes a loop phi, or that PHI elimination copies, is lost before allocation.
+// A strict hint already on \p NewReg wins; otherwise \p Reg's hint is carried over
+// unless both are soft, so a soft hint never replaces a strict one.
+static bool isScheduleHint(unsigned Type) {
+  return Type >= AMDGPURI::BankHint && Type <= AMDGPURI::StrictAGPRRegHint;
+}
+
+void SIRegisterInfo::updateRegAllocHint(Register Reg, Register NewReg,
+                                        MachineFunction &MF) const {
+  if (!Reg.isVirtual() || !NewReg.isVirtual())
+    return;
+  MachineRegisterInfo &MRI = MF.getRegInfo();
+  std::pair<unsigned, Register> Old = MRI.getRegAllocationHint(Reg);
+  if (!isScheduleHint(Old.first))
+    return;
+  std::pair<unsigned, Register> Cur = MRI.getRegAllocationHint(NewReg);
+  // A schedule hint already on NewReg wins unless Reg's is strict and it is not.
+  if (isScheduleHint(Cur.first) && ((Cur.first & 1) || !(Old.first & 1)))
+    return;
+  MRI.setRegAllocationHint(NewReg, Old.first, Old.second);
+}
